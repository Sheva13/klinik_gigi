APP_NAME="3K Dental Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ganti-dengan-domain-backend-anda

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=ganti-host-mysql
DB_PORT=3306
DB_DATABASE=ganti-nama-database
DB_USERNAME=ganti-user-database
DB_PASSWORD=ganti-password-database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@klinikgigi.test"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin-yang-kuat

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true
MIDTRANS_ENVIRONMENT=sandbox

# Opsional saat deploy pertama:
# RUN_MIGRATIONS=true
